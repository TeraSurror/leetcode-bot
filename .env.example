# Discord application credentials — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) ID for fast, dev-only slash command deployment. Leave blank
# to deploy globally instead (global registration can take up to an hour to
# propagate, so a guild ID is strongly recommended during development).
DISCORD_GUILD_ID=

# Channel the daily/weekly digest gets posted to (right-click the channel
# in Discord with Developer Mode on -> Copy Channel ID)
DIGEST_CHANNEL_ID=

# Cron expression for the daily digest, in the server's local time.
# Default: 8:00 AM every day.
DIGEST_CRON="0 8 * * *"

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/bot.db
